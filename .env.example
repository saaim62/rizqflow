# =============================================================================
# RizqFlow — environment variables (EXAMPLE — copy to .env.server, fill in
# your own values, never commit the filled file)
#
# Production (docker-compose.prod.yml) reads these from `.env.server` in the
# repo root on the host. For a plain local run (`npm run dev`), Next.js reads
# `.env.local` instead — same variable names.
# =============================================================================

# --- Accounts database (optional) -------------------------------------------
# Postgres connection string for user accounts + saved portfolios.
# Without it the site still serves; only /api/auth/*, /api/me and
# /api/portfolios answer 503 and the app runs in anonymous local mode.
DATABASE_URL=postgres://rizqflow:CHANGE_ME@localhost:5432/rizqflow

# --- Postgres container (docker-compose.prod.yml `db` service only) ---------
# Credentials for RizqFlow's OWN database container (separate instance,
# volume and credentials from any other app on the host). Keep these
# consistent with the password inside DATABASE_URL above.
POSTGRES_USER=rizqflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=rizqflow

# --- AI Assist (optional) ----------------------------------------------------
# Provider order (NOTES #52): Gemini is the PRIMARY model for AI Assist
# predictions (sparkle buttons / AI Fill / stock outlook); Groq
# GPT-OSS 120B is the FALLBACK. Keys are server-side only — never
# exposed to the browser. Either key alone keeps AI Assist working;
# with neither, the app works fully and the sparkle buttons hide.
GEMINI_API_KEY=
<redacted>
# Fallback model host. Also used for grounded (browser_search)
# live-price attempts and as the extraction fallback.
GROQ_API_KEY=
<redacted>

# Web search for vehicle specs (optional, NOTES #47): Tavily primary,
# Serper fallback. Without them, vehicle fields skip the sourced-data
# pipeline and go straight to the model chain.
TAVILY_API_KEY=
<redacted>
</atem:invoke>
</atem:function_calls>

# --- Dynamic market-price refresh (optional, Amendment 4) -------------------
# Server-side only. When set, /api/market-snapshot/refresh fetches a fresh
# stamped snapshot from this URL (JSON: { rates, silverPerTolaPkr, dataAsOf,
# source, ... }) and serves it through /api/market-snapshot. The browser
# never calls the provider. Without it the app serves the stamped seed in
# src/data/marketData.ts (Forgewarden Gate 2).
MARKET_SNAPSHOT_PROVIDER_URL=
# Optional shared secret guarding the refresh endpoint (send as
# x-refresh-secret header or ?secret=). Leave empty for open dev access.
MARKET_REFRESH_SECRET=

# --- Runtime (set by docker-compose.prod.yml in production) -----------------
NODE_ENV=production
PORT=3000
